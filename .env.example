# ── Database ──────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is REQUIRED — docker-compose will refuse to start without it
POSTGRES_USER=agentsentinel
POSTGRES_PASSWORD=<generate: openssl rand -hex 32>
POSTGRES_DB=agentsentinel

DATABASE_URL=postgresql+asyncpg://agentsentinel:<POSTGRES_PASSWORD>@localhost:5432/agentsentinel

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD is REQUIRED — docker-compose will refuse to start without it
REDIS_PASSWORD=<generate: openssl rand -hex 32>
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

# ── Application ───────────────────────────────────────────────────────────────
# SECRET_KEY must be at least 32 chars; used for HMAC key hashing
SECRET_KEY=<generate: openssl rand -hex 32>

LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Alerts (optional) ─────────────────────────────────────────────────────────
# Must point to hooks.slack.com over HTTPS or leave blank to disable
SLACK_WEBHOOK_URL=

# ── AgentSentinel API key ─────────────────────────────────────────────────────
# Copy the bootstrap key printed on first startup, or create one via POST /api/v1/keys
AGENTSENTINEL_API_KEY=
